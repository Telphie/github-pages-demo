{
  "name": "github-pages-demo",
  "version": "1.0.0",
  "private": true,
  "author": "Смирнова А.М.",
  "homepage": "https://telphie.github.io/github-pages-demo",
  "dependencies": {
    "@types/node": "16.18.126",
    "@types/react": "18.3.28",
    "@types/react-dom": "18.3.7",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-scripts": "5.0.1",
    "typescript": "4.9.5"
  },
  "devDependencies": {
    "gh-pages": "6.3.0",
    "json-server": "0.17.4"
  },
  "scripts": {
    "start": "react-scripts start",
    "serve": "json-server --watch ./src/server/db/index.js --routes ./src/server/routes.json --port 3001",
    "build": "react-scripts build",
    "save-json-api": "node ./src/server/scripts/save-json-api.js",
    "postbuild": "npm run save-json-api",
    "predeploy": "node -e \"require('fs').rmSync('build',{recursive:true,force:true})\" && npm run build",
    "deploy": "gh-pages -d build"
  },
  "eslintConfig": {
    "extends": ["react-app"]
  },
  "browserslist": {
    "production": [">0.2%", "not dead", "not op_mini all"],
    "development": ["last 1 chrome version", "last 1 firefox version", "last 1 safari version"]
  }
}
